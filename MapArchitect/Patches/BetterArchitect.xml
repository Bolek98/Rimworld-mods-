<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Better Architect Menu: the four "map" categories go next to Orders, Zones and Locations
       (the Colony group) and show although they have no buildings – only when that mod is loaded -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Better Architect Menu</li>
    </mods>
    <match Class="PatchOperationAddModExtension">
      <xpath>Defs/DesignationCategoryDef[defName="MA_MapArchitect" or defName="MA_Terrain" or defName="MA_Nature" or defName="MA_Objects"]</xpath>
      <value>
        <li Class="BetterArchitect.SpecialCategoryExtension" />
        <li Class="BetterArchitect.NestedCategoryExtension">
          <parentCategory>Ferny_Colony</parentCategory>
        </li>
      </value>
    </match>
  </Operation>
</Patch>
