<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ResearchProjectDef>
    <defName>MC_MechUpgrades</defName>
    <label>mech upgrade modules</label>
    <description>Simple modules that make mechanoids reach further, last longer and move faster: relay, efficient battery and servo modules, made at the fabrication bench.</description>
    <baseCost>800</baseCost>
    <techLevel>Industrial</techLevel>
    <prerequisites><li>BasicMechtech</li></prerequisites>
    <researchViewX>10.00</researchViewX>
    <researchViewY>6.20</researchViewY>
  </ResearchProjectDef>
  <ResearchProjectDef>
    <defName>MC_AdvancedMechUpgrades</defName>
    <label>advanced mech modules</label>
    <description>Advanced mechanoid modules: work processor, armor plating, self-repair nanites and tactical processor.</description>
    <baseCost>2000</baseCost>
    <techLevel>Spacer</techLevel>
    <prerequisites><li>StandardMechtech</li><li>MC_MechUpgrades</li></prerequisites>
    <researchViewX>12.00</researchViewX>
    <researchViewY>6.20</researchViewY>
  </ResearchProjectDef>
  <ThingDef Name="MC_ModuleBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <drawerType>MapMeshOnly</drawerType>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <stackLimit>10</stackLimit>
    <alwaysHaulable>true</alwaysHaulable>
    <pathCost>14</pathCost>
    <tickerType>Never</tickerType>
    <thingCategories><li>Manufactured</li></thingCategories>
    <graphicData>
      <texPath>Things/Item/Resource/ComponentSpacer</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Mass>1</Mass>
      <Flammability>0.4</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
    </statBases>
    <comps><li Class="CompProperties_Forbiddable"/></comps>
  </ThingDef>
  <HediffDef>
    <defName>MC_Hediff_Relay</defName>
    <label>mech relay</label>
    <description>Lets the mech take orders anywhere on its overseer's map, not only in the command range.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55,0.8,1)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages><li></li></stages>
    
  </HediffDef>
  <ThingDef ParentName="MC_ModuleBase">
    <defName>MC_Module_Relay</defName>
    <label>mech relay module</label>
    <description>Lets the mech take orders anywhere on its overseer's map, not only in the command range. Install it with the "Modules" button on a selected mech. A mech holds up to 3 modules.</description>
    <graphicData><color>(0.55,0.8,1)</color></graphicData>
    <statBases><MarketValue>600</MarketValue></statBases>
    <techLevel>Industrial</techLevel>
    <modExtensions><li Class="MechCommander.ModuleExtension"><hediff>MC_Hediff_Relay</hediff></li></modExtensions>
  </ThingDef>
  <RecipeDef>
    <defName>MC_Make_Relay</defName>
    <label>make mech relay module</label>
    <description>Make a mech relay module.</description>
    <jobString>Making mech relay module.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <workAmount>3000</workAmount>
    <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
    <ingredients><li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>40</count></li><li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>3</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>Steel</li><li>ComponentIndustrial</li></thingDefs></fixedIngredientFilter>
    <products><MC_Module_Relay>1</MC_Module_Relay></products>
    <skillRequirements><Crafting>6</Crafting></skillRequirements>
    <researchPrerequisite>MC_MechUpgrades</researchPrerequisite>
    <recipeUsers><li>FabricationBench</li></recipeUsers>
  </RecipeDef>
  <HediffDef>
    <defName>MC_Hediff_Battery</defName>
