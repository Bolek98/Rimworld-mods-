  <WeatherDef>
    <defName>SH_SpringShowers</defName>
    <label>spring showers</label>
    <description>Short light showers with sun in between. Good for the fields.</description>
    <repeatable>true</repeatable>
    <temperatureRange>2~100</temperatureRange>
    <windSpeedFactor>1.1</windSpeedFactor>
    <accuracyMultiplier>0.9</accuracyMultiplier>
    <favorability>Neutral</favorability>
    <perceivePriority>1</perceivePriority>
    <rainRate>0.4</rainRate>
    <moveSpeedMultiplier>0.95</moveSpeedMultiplier>
    <ambientSounds>
      <li>Ambient_Rain</li>
    </ambientSounds>
    <overlayClasses>
      <li>WeatherOverlay_Rain</li>
    </overlayClasses>
    <skyColorsDay>
      <sky>(0.86,0.88,0.86)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.8,0.8,0.8)</overlay>
      <saturation>1</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(1,0.95,0.9)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.65,0.65,0.65)</overlay>
      <saturation>1</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.35,0.40,0.45)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.5,0.5,0.5)</overlay>
