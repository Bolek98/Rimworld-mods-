<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <WeatherDef>
    <defName>SH_Hoarfrost</defName>
    <label>hoarfrost</label>
    <description>A frosty, still, crystal-clear day. Everything outside is covered in white frost.</description>
    <repeatable>true</repeatable>
    <temperatureRange>-999~2</temperatureRange>
    <favorability>Good</favorability>
    <perceivePriority>0</perceivePriority>
    <windSpeedFactor>0.3</windSpeedFactor>
    <ambientSounds>
      <li>Ambient_Wind_Clear</li>
    </ambientSounds>
    <skyColorsDay>
      <sky>(0.88,0.95,1.05)</sky>
      <shadow>(0.718,0.745,0.757)</shadow>
      <overlay>(1,1,1)</overlay>
      <saturation>0.85</saturation>
    </skyColorsDay>
    <skyColorsDusk>
      <sky>(0.80,0.78,0.92)</sky>
      <shadow>(0.955,0.886,0.914)</shadow>
      <overlay>(0.8,0.8,0.8)</overlay>
      <saturation>0.85</saturation>
    </skyColorsDusk>
    <skyColorsNightEdge>
      <sky>(0.482,0.603,0.682)</sky>
      <shadow>(0.92,0.92,0.92)</shadow>
      <overlay>(0.6,0.6,0.6)</overlay>
      <saturation>0.85</saturation>
    </skyColorsNightEdge>
    <skyColorsNightMid>
      <sky>(0.482,0.603,0.682)</sky>
      <shadow>(0.85, 0.85, 0.85)</shadow>
      <overlay>(0.6,0.6,0.6)</overlay>
      <saturation>0.85</saturation>
    </skyColorsNightMid>
  </WeatherDef>

