<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- 0.5.0: Christmas cookies give a mood bonus when eaten in December and January -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="SH_ChristmasCookies"]/comps</xpath>
    <value>
      <li Class="SeasonsHolidays.CompProperties_SHSeasonalFood">
        <months><li>11</li><li>0</li></months>
      </li>
    </value>
  </Operation>
</Patch>
