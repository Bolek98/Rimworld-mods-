  <!-- FINAL texture: Things/Building/PowerWaterWorks/HydroPlant (3x3, rotatable) – placeholder below -->
  <ThingDef ParentName="BuildingBase">
    <defName>PWW_HydroPlant</defName>
    <label>hydro power plant</label>
    <description>A small run-of-river power plant with several turbines. At least three of its cells must stand on moving water, the rest on firm ground. Gives steady power day and night; when the river freezes in hard winter it gives only 40 %.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/PowerWaterWorks/HydroPlant</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,3)</drawSize>
      <color>(1,1,1)</color>
      <damageData><rect>(0.1,0.1,0.8,0.8)</rect></damageData>
    </graphicData>
    <size>(3,3)</size>
    <rotatable>true</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>0.8</fillPercent>
    <blockWind>false</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <tickerType>Normal</tickerType>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>9000</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Beauty>-10</Beauty>
    </statBases>
    <costList><Steel>250</Steel><ComponentIndustrial>5</ComponentIndustrial><WoodLog>50</WoodLog></costList>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <designationCategory>Power</designationCategory>
    <constructEffect>ConstructMetal</constructEffect>
    <researchPrerequisites><li>PWW_PowerWorks</li></researchPrerequisites>
    <placeWorkers><li>PowerWaterWorks.PlaceWorker_Hydro</li></placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>PowerWaterWorks.CompPowerPlantHydro</compClass>
        <basePowerConsumption>-2400</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="PowerWaterWorks.CompProperties_GridOverview"/>
    </comps>
  </ThingDef>
