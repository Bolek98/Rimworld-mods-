<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Lively Pawns: muzzle glow, flare, gun smoke, shell casing, dust and snow under the feet -->
  <FleckDef>
    <defName>LP_MuzzleGlow</defName>
    <fleckSystemClass>FleckSystemStatic</fleckSystemClass>
    <graphicData>
      <graphicClass>Graphic_Fleck</graphicClass>
      <texPath>LivelyPawns/Flecks/Glow</texPath>
      <shaderType>MoteGlow</shaderType>
      <drawSize>1.5</drawSize>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0</fadeInTime>
    <solidTime>0.03</solidTime>
    <fadeOutTime>0.1</fadeOutTime>
  </FleckDef>
  <FleckDef>
    <defName>LP_MuzzleFlare</defName>
    <fleckSystemClass>FleckSystemStatic</fleckSystemClass>
