      <graphicClass>Graphic_Fleck</graphicClass>
      <texPath>LivelyPawns/Flecks/Flare</texPath>
      <shaderType>MoteGlow</shaderType>
      <drawSize>0.75</drawSize>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0</fadeInTime>
    <solidTime>0.02</solidTime>
    <fadeOutTime>0.06</fadeOutTime>
  </FleckDef>
  <FleckDef>
    <defName>LP_GunSmoke</defName>
    <fleckSystemClass>FleckSystemThrown</fleckSystemClass>
    <graphicData>
      <graphicClass>Graphic_Fleck</graphicClass>
      <texPath>LivelyPawns/Flecks/Puff</texPath>
      <shaderType>Mote</shaderType>
      <color>(0.82, 0.82, 0.82, 0.45)</color>
      <drawSize>0.45</drawSize>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.04</fadeInTime>
    <solidTime>0.15</solidTime>
    <fadeOutTime>0.9</fadeOutTime>
    <growthRate>0.7</growthRate>
  </FleckDef>
  <FleckDef>
    <defName>LP_Shell</defName>
    <fleckSystemClass>FleckSystemThrown</fleckSystemClass>
    <graphicData>
      <graphicClass>Graphic_Fleck</graphicClass>
      <texPath>LivelyPawns/Flecks/Shell</texPath>
