<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build: dotnet build -c Release. Set RimWorldDir if your RimWorld is elsewhere. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BodyFit</AssemblyName>
    <RootNamespace>BodyFit</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">C:\Programy\Steam\steamapps\common\RimWorld</RimWorldDir>
    <Managed Condition="'$(Managed)' == ''">$(RimWorldDir)\RimWorldWin64_Data\Managed</Managed>
    <UseGameRefs Condition="Exists('$(Managed)\Assembly-CSharp.dll')">true</UseGameRefs>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" Condition="'$(UseGameRefs)' != 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseGameRefs)' == 'true'">
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Managed)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
