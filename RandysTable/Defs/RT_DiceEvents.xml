<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>RT_Sit_Rested</defName>
    <label>dice dreams</label>
    <description>Dice the Gambler sent good dreams: sleep refreshes more.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85, 0.75, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000~120000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <RestFallRateFactor>0.7</RestFallRateFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>RT_Sit_Focus</defName>
    <label>sharp mind</label>
    <description>Today everything sticks: learning is faster.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85, 0.75, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000~120000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <GlobalLearningFactor>1.5</GlobalLearningFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>RT_Sit_GoldFever</defName>
    <label>gold fever</label>
    <description>Every rock might hide a fortune: more yield from mining, but nerves are thin.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85, 0.75, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000~120000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <MiningYield>1.5</MiningYield>
        </statFactors>
        <statOffsets>
          <MentalBreakThreshold>0.04</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>RT_Sit_LuckyHand</defName>
    <label>lucky hand</label>
    <description>The dice smile: surgery succeeds more often and words persuade better.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85, 0.75, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>180000~180000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <MedicalSurgerySuccessChance>1.25</MedicalSurgerySuccessChance>
          <NegotiationAbility>1.25</NegotiationAbility>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>RT_Sit_Blessing</defName>
    <label>gambler's blessing</label>
    <description>Work goes easily today.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85, 0.75, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000~60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <WorkSpeedGlobal>1.25</WorkSpeedGlobal>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>RT_Sit_BadLuck</defName>
    <label>unlucky day</label>
    <description>Everything goes wrong – but you learn twice as much from mistakes.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85, 0.75, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000~60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>0.9</MoveSpeed>
          <GlobalLearningFactor>2.0</GlobalLearningFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
  <ThoughtDef>
    <defName>RT_Thought_Festival</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>dice festival</label>
        <description>Dice the Gambler declared a feast day. Music, games and laughter!</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RT_Thought_CleanHome</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>sparkling home</label>
        <description>We cleaned the whole place for the Gambler's challenge. It feels so good.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RT_Thought_GreatHunt</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>great hunt</label>
        <description>We won the Gambler's hunting challenge!</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RT_Thought_QuietWeek</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>peaceful days</label>
        <description>Days without a single breakdown. We really are a good team.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RT_Thought_Whisper</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>the dice whisper</label>
        <description>Something whispers numbers in the dark. It's unsettling.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RT_Thought_Fortress</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>we held the fortress</label>
        <description>We came through the Gambler's test without losing anyone.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RT_Thought_LostBet</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>lost bet</label>
        <description>We gambled and lost. Ugh.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RT_Thought_WonBet</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>won bet</label>
        <description>We gambled and won!</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>RT_Thought_FailedChallenge</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>failed the Gambler</label>
        <description>The Gambler set us a task and we failed it.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
  <LetterDef>
    <defName>RT_DiceChoice</defName>
    <letterClass>RandysTable.ChoiceLetter_Dice</letterClass>
    <color>(220, 180, 90)</color>
    <flashColor>(240, 210, 120)</flashColor>
    <flashInterval>90</flashInterval>
    <arriveSound>LetterArrive_Good</arriveSound>
  </LetterDef>
</Defs>
