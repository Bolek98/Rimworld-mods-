  </ThingDef>

  <HediffDef>
    <defName>AP_CalmingTeaHigh</defName>
    <hediffClass>Hediff_High</hediffClass>
    <label>calming tea</label>
    <description>A calm, warm feeling.</description>
    <defaultLabelColor>(0.6,0.8,0.5)</defaultLabelColor>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li />
    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>AP_CalmingTea</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>AP_CalmingTeaHigh</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>calming tea</label>
        <description>A cup of calming tea. Everything feels a little easier.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

